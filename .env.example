# Copy to .env.local.
# Model: openai/gpt-6-luna by default, or any OpenRouter model id. The key comes from your environment or this file.
MODEL_NAME=openai/gpt-6-luna
OPEN_ROUTER_API=
# SQLite file for the backend; defaults to calendaby.db in the project folder.
# DB_PATH=
# Extra addresses allowed to call the server from a browser, comma separated, e.g. https://calendaby.vercel.app,https://calenbaby.eabonet.com
# The app's own address and the phone apps are always allowed; setting this also makes the agent refuse every other site.
AGENT_ALLOWED_ORIGIN=
# Clerk sign-in (optional). Publishable key is safe for the browser; the secret key stays server-side.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
