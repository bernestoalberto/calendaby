# Vercel project settings (Project > Settings > Environment Variables). Not needed for local dev.
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# From `uv run agentcore launch` output. Leave empty to keep the agent switched off.
AGENT_RUNTIME_ARN=
# Your production URL, e.g. https://calendaby.vercel.app
AGENT_ALLOWED_ORIGIN=
