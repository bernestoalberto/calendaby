{
  "name": "calendaby",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "cap:sync": "npm run build && cap sync",
    "android:install": "node scripts/android-install.mjs",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios",
    "lint": "oxlint",
    "preview": "vite preview",
    "check": "npm run lint && npm run build && npm test",
    "prepare": "husky",
    "screenshots": "node scripts/make-screenshots.mjs",
    "evals:webmcp": "npx --yes webmcp-evals@0.0.4 local -t evals/webmcp/schema.json -e evals/webmcp/evals.json",
    "evals:webmcp:smoke": "npx --yes webmcp-evals@0.0.4 smoke -u http://localhost:5173 -e evals/webmcp/evals.json -v"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.0",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capgo/capacitor-speech-recognition": "^8.4.4",
    "@clerk/backend": "^3.26.1",
    "@clerk/react": "^6.18.0",
    "@libsql/client": "^0.18.0",
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "ai": "^7.0.150",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "^9.1.7",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
